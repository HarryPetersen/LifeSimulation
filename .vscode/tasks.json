{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure LifeSimulation",
            "type": "process",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build"],
            "problemMatcher": []
        },
        {
            "label": "Build SFML Project",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
            "dependsOn": "Configure LifeSimulation",
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "Test LifeSimulation",
            "type": "process",
            "command": "ctest",
            "args": ["--test-dir", "${workspaceFolder}/build", "-C", "Debug", "--output-on-failure"],
            "dependsOn": "Build SFML Project",
            "problemMatcher": []
        }
    ]
}
